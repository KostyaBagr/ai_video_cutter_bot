TELEGRAM_BOT_TOKEN=your_telegram_bot_token
RUNWARE_API_KEY=your_runware_api_key

# SOCKS5h до api.telegram.org (DNS резолвит прокси, не сервер)
# TELEGRAM_PROXY=socks5h://user:password@host:1080

# prod | debug — in debug only DEBUG_TELEGRAM_ID can use the bot
APP_ENV=prod
# DEBUG_TELEGRAM_ID=123456789

# YooKassa via Telegram Payments (BotFather → Payments → Connect ЮKassa)
# YOOKASSA_PROVIDER_TOKEN=your_provider_token_from_botfather

# TikTok often requires cookies. Prefer a Netscape cookies.txt file:
# YTDLP_COOKIES_FILE=./cookies.txt
# In Docker (see docker-compose.yml mount):
# YTDLP_COOKIES_FILE=/app/cookies.txt
# Or read cookies from a local browser (host only, not Docker):
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Optional overrides (defaults are fine for local / compose):
# SQLITE_PATH=.data/bot.db
# VIDEO_CACHE_DIR=.cache/videos
